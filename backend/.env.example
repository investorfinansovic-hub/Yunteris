# Postgres connection used by Prisma
DATABASE_URL="postgresql://cleanmarket:cleanmarket@localhost:5432/cleanmarket?schema=public"

# Secret used to sign JWTs — replace with a long random value in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000

