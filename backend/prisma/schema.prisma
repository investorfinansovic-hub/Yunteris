generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  CLEANER
  ADMIN
}

enum OrderStatus {
  SEARCHING   // published, visible to subscribed cleaners in the district
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionPaymentStatus {
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  cleanerProfile CleanerProfile?

  clientOrders  Order[] @relation("ClientOrders")
  cleanerOrders Order[] @relation("CleanerOrders")

  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model CleanerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  verified     Boolean  @default(false)
  bio          String?
  ratingAvg    Float    @default(0)
  ratingCount  Int      @default(0)
  serviceAreas String[] // districts served, e.g. ["Мотовилихинский", "Ленинский"]

  subscription Subscription?
}

model Service {
  id          String          @id @default(cuid())
  code        String          @unique // SUPPORT, GENERAL, POST_RENOVATION, MOVING
  name        String
  basePrice   Int             // rubles
  description String?
  options     ServiceOption[]
  orders      Order[]
}

model ServiceOption {
  id        String   @id @default(cuid())
  code      String   @unique // windows, oven, fridge, balcony, ironing
  name      String
  price     Int
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  orders OrderOption[]
}

model Order {
  id        String @id @default(cuid())
  clientId  String
  client    User   @relation("ClientOrders", fields: [clientId], references: [id])
  cleanerId String?
  cleaner   User?  @relation("CleanerOrders", fields: [cleanerId], references: [id])

  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id])
  options   OrderOption[]

  address     String
  district    String
  scheduledAt DateTime
  status      OrderStatus @default(SEARCHING)
  price       Int // estimated price shown to the client; paid directly to the cleaner, off-platform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?
}

model OrderOption {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id])
  optionId String
  option   ServiceOption @relation(fields: [optionId], references: [id])

  @@unique([orderId, optionId])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  fromUserId String
  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

/// A subscription plan cleaners pay for to see and accept leads. One default
/// plan is seeded, but the model allows several (e.g. by district count).
model SubscriptionPlan {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  price      Int // rubles per period
  periodDays Int      @default(30)

  subscriptions Subscription[]
}

model Subscription {
  id               String         @id @default(cuid())
  cleanerProfileId String         @unique
  cleanerProfile   CleanerProfile @relation(fields: [cleanerProfileId], references: [id])
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])

  status          SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime

  // Recurring-billing bookkeeping — TODO: populate from a real ЮKassa
  // rebilling integration (see billing/provider-charge.service.ts).
  provider               String  @default("stub")
  providerCustomerId     String?
  providerPaymentMethodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String                    @id @default(cuid())
  subscriptionId String
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id])
  amount         Int
  status         SubscriptionPaymentStatus
  providerPaymentId String?
  createdAt      DateTime                  @default(now())
}
